$$ ; dimension 2D; AQ_mode  (F1) QF
$$ define delay MCWRK
$$ define delay MCREST
$$ define delay d0orig
$$ "d0orig=d0"
$$ define loopcounter t1loop
$$ "t1loop=0"
$$ define loopcounter ph1loop
$$ "ph1loop=0"
$$ define loopcounter ST1CNT
$$ "ST1CNT = td1 / 1"
$$ "MCREST = d1 - d1"
$$ "MCWRK = 0.500000*d1"
$$ 
$$     dccorr

$$   p16:gp1
$$   d16
$$   p2 ph2
$$   50u
$$   p16:gp2
$$   d16
$$   d0
$$   p3:f2 ph5
$$   4u
$$   p16:gp3
$$   d16
$$   4u setnmr3^0 setnmr0^34^32^33 ctrlgrad 7
$$   go=2 ph31
$$ # 1 "mc_line 55 file /opt/topspin3.5pl7/exp/stan/nmr/lists/pp/hmbcgplpndqf exp. mc cmd. in line"
$$   MCWRK  wr #0 if #0 zd 
$$ 
$$   "t1loop+=1"
